# Replace a soft body's material; the model is rebuilt and the scenario resets.
# material: a preset name ("ecoflex_00_10"), a YAML file path, or a YAML mapping,
#   e.g. "{preset: ecoflex_00_10, elastic: {youngs_modulus: 40 kPa}}"; empty = keep the current material.
# overrides: dotted card overrides applied on top, e.g. ["elastic.youngs_modulus=40 kPa", "damping.tau[0]=2 ms"].
string body
string material
string[] overrides
---
bool success
string message
